#!/usr/bin/env python3
"""Run bundled collectors and atomically publish their records for the panel."""
from __future__ import annotations

import argparse
import json
import os
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
import sys
sys.path.insert(0, str(ROOT))

from agent_usage_collectors.deepseek import collect as collect_deepseek  # noqa: E402
from agent_usage_collectors.cursor import collect as collect_cursor  # noqa: E402
from agent_usage_collectors.devin import collect as collect_devin  # noqa: E402
from agent_usage_collectors.gemini import collect as collect_gemini  # noqa: E402
from agent_usage_collectors.kimi import collect as collect_kimi  # noqa: E402
from agent_usage_collectors.opencode_go import collect as collect_opencode_go  # noqa: E402
from agent_usage_collectors.openrouter import collect as collect_openrouter  # noqa: E402
from agent_usage_collectors.xai import collect as collect_xai  # noqa: E402
from agent_usage_collectors.zai import collect as collect_zai  # noqa: E402

COLLECTORS = {
    "openrouter": collect_openrouter,
    "deepseek": collect_deepseek,
    "xai": collect_xai,
    "zai": collect_zai,
    "gemini": collect_gemini,
    "cursor": collect_cursor,
    "devin": collect_devin,
    "kimi": collect_kimi,
    "opencode-go": collect_opencode_go,
}

PROVIDER_ALIASES = {
    "opencode": "opencode-go",
}


def usage_dir() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")) / "omarchy" / "agents" / "usage"


def publish(record: dict) -> None:
    # Collectors already carry forward the last known-good numeric fields
    # into a problem record themselves (agent_usage_collectors.common), so
    # this only needs to write whatever collect() returned. The filename
    # follows the record id so an OpenCode Go refresh updates the existing
    # OpenCode mark rather than sitting next to a stale opencode.json.
    agent_id = record["id"]
    destination = usage_dir()
    destination.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=destination, prefix=f".{agent_id}.", delete=False) as handle:
        json.dump(record, handle, separators=(",", ":"), sort_keys=True)
        handle.write("\n")
        temporary = Path(handle.name)
    temporary.chmod(0o600)
    temporary.replace(destination / f"{agent_id}.json")


def selected_providers(argv: list[str] | None = None) -> list[str]:
    parser = argparse.ArgumentParser(description="Publish Agent Usage Plus API-provider records")
    parser.add_argument("command", choices=["update"], nargs="?", default="update")
    parser.add_argument("--force", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--limits-only", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--except", dest="excluded", action="append", default=[])
    parser.add_argument("providers", metavar="provider", nargs="*")
    # The widget dispatcher forwards filters in the same order it received
    # them.  Python 3.12's parse_args stops collecting positional providers
    # after --except, whereas parse_intermixed_args supports either order.
    args = parser.parse_intermixed_args(argv)
    requested = args.providers if args.providers else sorted(COLLECTORS)
    excluded = {PROVIDER_ALIASES.get(name, name) for name in args.excluded}
    resolved = []
    seen = set()
    for name in requested:
        provider = PROVIDER_ALIASES.get(name, name)
        if provider in COLLECTORS and provider not in excluded and provider not in seen:
            seen.add(provider)
            resolved.append(provider)
    return resolved


def main() -> int:
    for agent_id in selected_providers():
        publish(COLLECTORS[agent_id]())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
