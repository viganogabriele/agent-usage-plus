#!/usr/bin/env bash
set -u

# One updater entry point for the widget. Omarchy keeps ownership of its
# packaged collectors; this plugin handles only the providers it bundles.
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
base_updater=${AGENT_USAGE_PLUS_BASE_UPDATER:-}
bundled_runner=${AGENT_USAGE_PLUS_BUNDLED_RUNNER:-"$script_dir/agent-usage-plus-collectors"}
account_runner="$script_dir/agent-usage-plus-accounts"

if [[ -z $base_updater ]]; then
  local_updater=${XDG_BIN_HOME:-"$HOME/.local/bin"}/omarchy-agent-usage-update
  if [[ -x $local_updater ]]; then
    base_updater=$local_updater
  else
    base_updater="$script_dir/omarchy-agent-usage-update"
  fi
fi
# Use the same live compatibility reader for the default Codex account and
# imported accounts, even when the optional companion package is not installed.
export AGENT_USAGE_PLUS_CODEX_COLLECTOR=${AGENT_USAGE_PLUS_CODEX_COLLECTOR:-"$script_dir/omarchy-agent-usage-codex-cost"}
# Claude, like Codex, goes through the cost wrapper: it runs the
# compatibility reader that adds Claude's saved free resets, then adds the
# local API-price estimate (by model and by day) the Cost view shows. Should
# it fail, the base updater refreshes Claude itself.
export AGENT_USAGE_PLUS_CLAUDE_COLLECTOR=${AGENT_USAGE_PLUS_CLAUDE_COLLECTOR-"$script_dir/omarchy-agent-usage-claude-cost"}

flags=()
declare -A requested=()
declare -A excluded=()
args=()
profiles_json='{}'
profiles_supplied=false
while (($#)); do
  if [[ $1 == --profiles-json ]]; then
    profiles_json=${2:-'{}'}
    profiles_supplied=true
    shift 2
  else
    args+=("$1")
    shift
  fi
done
for ((index = 0; index < ${#args[@]}; index++)); do
  case ${args[$index]} in
    --force | --limits-only) flags+=("${args[$index]}") ;;
    --except)
      ((index += 1))
      if [[ -n ${args[$index]:-} ]]; then
        excluded["${args[$index]}"]=1
      fi
      ;;
    *) requested["${args[$index]}"]=1 ;;
  esac
done

wanted() {
  local provider="$1"
  [[ -v excluded["$provider"] ]] && return 1
  (( ${#requested[@]} == 0 )) && return 0
  [[ -v requested["$provider"] ]] && return 0
  return 1
}

bundled_wanted=()
for candidate in devin agy; do
  wanted "$candidate" && bundled_wanted+=("$candidate")
done

status=0
"$base_updater" "${args[@]}" --except devin --except agy &
base_pid=$!
if $profiles_supplied; then
  "$account_runner" --profiles-json "$profiles_json" "${args[@]}" &
  account_pid=$!
fi
if ((${#bundled_wanted[@]} > 0)); then
  "$bundled_runner" update "${flags[@]}" "${bundled_wanted[@]}" &
  bundled_pid=$!
fi

wait "$base_pid" || status=1
if [[ -n ${account_pid:-} ]]; then
  wait "$account_pid" || status=1
fi
if [[ -n ${bundled_pid:-} ]]; then
  wait "$bundled_pid" || status=1
fi
exit "$status"
