#!/usr/bin/env bash
set -u

# One updater entry point for the widget. Omarchy keeps ownership of its
# packaged collectors; this plugin handles only the providers it bundles.
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
base_updater=${AGENT_USAGE_PLUS_BASE_UPDATER:-}
bundled_runner=${AGENT_USAGE_PLUS_BUNDLED_RUNNER:-"$script_dir/agent-usage-plus-collectors"}

if [[ -z $base_updater ]]; then
  local_updater=${XDG_BIN_HOME:-"$HOME/.local/bin"}/omarchy-agent-usage-update
  if [[ -x $local_updater ]]; then
    base_updater=$local_updater
  else
    base_updater=/usr/share/omarchy/bin/omarchy-agent-usage-update
  fi
fi

flags=()
declare -A requested=()
declare -A excluded=()
args=("$@")
for ((index = 0; index < ${#args[@]}; index++)); do
  case ${args[$index]} in
    --force | --limits-only) flags+=("${args[$index]}") ;;
    --except)
      ((index += 1))
      if [[ -n ${args[$index]:-} ]]; then
        excluded["${args[$index]}"]=1
      fi
      ;;
    *) requested["${args[$index]}"]=1 ;;
  esac
done

wanted() {
  local provider="$1"
  [[ -v excluded["$provider"] ]] && return 1
  (( ${#requested[@]} == 0 )) && return 0
  [[ -v requested["$provider"] ]] && return 0
  return 1
}

bundled_wanted=()
for candidate in devin agy; do
  wanted "$candidate" && bundled_wanted+=("$candidate")
done

status=0
"$base_updater" "$@" --except devin --except agy &
base_pid=$!
if ((${#bundled_wanted[@]} > 0)); then
  "$bundled_runner" update "${flags[@]}" "${bundled_wanted[@]}" &
  bundled_pid=$!
fi

wait "$base_pid" || status=1
if [[ -n ${bundled_pid:-} ]]; then
  wait "$bundled_pid" || status=1
fi
exit "$status"
