#!/usr/bin/env python3
"""Run Omarchy's Claude collector and add Claude's saved free resets.

Claude grants free full resets of the rate limits ("Reset for free" in
claude.ai Settings > Usage). Anthropic reports them in a ``cedar_ember``
block of the same OAuth usage response Omarchy's collector already reads,
but only when the request opts in with ``?cedar_ember=1``.

This wrapper runs Omarchy's packaged collector unchanged except for two
runtime hooks: its usage request gains that query (and is retried once
without it if Anthropic rejects it, so the limits never suffer), and the
record it emits gains ``resetCredits: {available, nextExpiresAt}``, the shape
Omarchy's Codex collector already uses. It never reads credentials itself:
the request, token included, is built by Omarchy's code. Grant identifiers
and labels are never kept; the only thing cached between probes is the
expiry of each available reset, so a probe skipped by Omarchy's own reuse
window still shows the count, and an expired reset drops out on time.
"""
from __future__ import annotations

import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path
from typing import Any

HERE = Path(__file__).resolve().parent
SYSTEM_COLLECTOR = Path("/usr/share/omarchy/bin/omarchy-agent-usage-claude")
SAVED_NAME = "agent-usage-plus-base-claude"
OPT_IN_QUERY = "cedar_ember=1"
MAX_GRANT_RECORDS = 200
MAX_RESETS = 50


def base_candidates() -> list[Path]:
    configured = os.environ.get("AGENT_USAGE_PLUS_CLAUDE_BASE_COLLECTOR")
    omarchy_bin = Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy") / "bin"
    paths = [Path(configured)] if configured else []
    paths += [
        Path.home() / ".local/bin" / SAVED_NAME,
        omarchy_bin / SAVED_NAME,
        omarchy_bin / "omarchy-agent-usage-claude",
        SYSTEM_COLLECTOR,
    ]
    return paths


def resolve_base() -> Path | None:
    """The first Omarchy collector that is not one of this plugin's wrappers.

    ``install.sh --with-transcript-cost`` replaces Omarchy's collector with a
    symlink to omarchy-agent-usage-claude-cost, which runs this file: running
    that link as the base would recurse.
    """
    for path in base_candidates():
        try:
            if path.is_file() and path.resolve().parent != HERE:
                return path
        except OSError:
            continue
    return None


def _bound(value: Any) -> tuple[bool, dt.datetime | None]:
    """(readable, moment). Absent or null is an open bound."""
    if value is None:
        return True, None
    if not isinstance(value, str):
        return False, None
    try:
        moment = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return False, None
    if moment.tzinfo is None:
        return False, None
    return True, moment


def _whole(value: Any) -> int | None:
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def reset_expiries(block: Any, now: dt.datetime) -> list[str] | None:
    """One entry per available reset: its expiry (ISO) or "" when open-ended.

    None means the block says nothing usable (absent, ineligible or
    malformed as a whole); a malformed grant is dropped without hiding the
    rest. Paused, used-up, not-yet-started and expired grants don't count.
    """
    if not isinstance(block, dict) or block.get("eligible") is not True:
        return None
    grants = block.get("grants")
    if not isinstance(grants, list):
        return []
    if len(grants) > MAX_GRANT_RECORDS:
        return None
    expiries: list[str] = []
    for grant in grants:
        if not isinstance(grant, dict):
            continue
        left = _whole(grant.get("resets_left"))
        total = grant.get("resets_total")
        paused = grant.get("paused")
        if left is None or left < 0 or not isinstance(paused, bool):
            continue
        if total is not None and (_whole(total) is None or total < left):
            continue
        start_ok, start = _bound(grant.get("starts_at"))
        end_ok, end = _bound(grant.get("ends_at"))
        if not (start_ok and end_ok):
            continue
        if paused or left == 0 or (start and start > now) or (end and end <= now):
            continue
        if len(expiries) + left > MAX_RESETS:
            return None
        expiries += [end.astimezone(dt.timezone.utc).isoformat() if end else ""] * left
    return expiries


def summary(expiries: list[str] | None, now: dt.datetime) -> dict[str, Any] | None:
    """The record's ``resetCredits`` for the resets still unexpired at ``now``."""
    if not expiries:
        return None
    live = []
    for expiry in expiries:
        ok, moment = _bound(expiry or None)
        if ok and (moment is None or moment > now):
            live.append(moment)
    if not live:
        return None
    dated = [moment for moment in live if moment is not None]
    return {
        "available": len(live),
        "nextExpiresAt": min(dated).astimezone(dt.timezone.utc).isoformat() if dated else "",
    }


def cache_path() -> Path:
    config = os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
    key = hashlib.sha256(os.path.abspath(config).encode("utf-8")).hexdigest()[:16]
    root = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    return root / "agent-usage-plus" / f"claude-reset-credits-{key}.json"


def load_cached() -> list[str] | None:
    try:
        data = json.loads(cache_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    expiries = data.get("expiries") if isinstance(data, dict) else None
    if not isinstance(expiries, list) or len(expiries) > MAX_RESETS:
        return None
    return [value for value in expiries if isinstance(value, str)]


def save_cached(expiries: list[str]) -> None:
    path = cache_path()
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        handle, temporary = tempfile.mkstemp(dir=path.parent, prefix=".claude-reset-credits.")
        with os.fdopen(handle, "w", encoding="utf-8") as output:
            json.dump({"expiries": expiries}, output)
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    except OSError:
        pass


def claude_cli_version() -> str:
    try:
        result = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=5)
        match = re.match(r"\s*(\d+\.\d+\.\d+)", result.stdout)
        if match:
            return match.group(1)
    except (OSError, subprocess.SubprocessError):
        pass
    return "2.1.0"


def rejects_opt_in(error: Any) -> bool:
    status = getattr(error, "status", 0)
    body = getattr(error, "body", b"") or b""
    return status == 400 or (status == 403 and b"user:profile" not in body)


class Tracker:
    """Wraps the collector's open_json and emit for one run."""

    def __init__(self, namespace: dict[str, Any], now: dt.datetime | None = None, version: Any = claude_cli_version):
        self.namespace = namespace
        self.endpoint = str(namespace.get("USAGE_ENDPOINT") or "")
        self.open_json = namespace["open_json"]
        self.emit = namespace["emit"]
        self.http_error = namespace.get("HttpError", Exception)
        self.now = now or dt.datetime.now(dt.timezone.utc)
        self.version = version
        self.probes: dict[str, list[str] | None] = {}

    def install(self) -> None:
        self.namespace["open_json"] = self.wrapped_open_json
        self.namespace["emit"] = self.wrapped_emit

    def wrapped_open_json(self, request: Any, *args: Any, **kwargs: Any) -> Any:
        if not isinstance(request, urllib.request.Request) or request.full_url != self.endpoint:
            return self.open_json(request, *args, **kwargs)
        # Tells accounts apart within one run without keeping the token.
        who = hashlib.sha256(str(request.get_header("Authorization") or "").encode("utf-8")).hexdigest()
        version = self.version() if callable(self.version) else str(self.version)
        headers = dict(request.header_items())
        headers["User-Agent"] = f"claude-cli/{version} (external, cli)"
        opted = urllib.request.Request(f"{self.endpoint}?{OPT_IN_QUERY}", headers=headers, method=request.get_method())
        try:
            payload = self.open_json(opted, *args, **kwargs)
        except self.http_error as error:
            if not rejects_opt_in(error):
                raise
            return self.open_json(request, *args, **kwargs)
        if isinstance(payload, dict):
            self.probes[who] = reset_expiries(payload.get("cedar_ember"), self.now)
        return payload

    def wrapped_emit(self, record: Any, *args: Any, **kwargs: Any) -> Any:
        if isinstance(record, dict) and record.get("id") == "claude":
            expiries = self.current()
            credits = summary(expiries, self.now)
            if credits:
                record["resetCredits"] = credits
        return self.emit(record, *args, **kwargs)

    def current(self) -> list[str] | None:
        # Omarchy's own multi-account mode probes several logins in one run;
        # their answers can't be matched to records safely, so they show none.
        if len(self.probes) > 1:
            return None
        if len(self.probes) == 1:
            expiries = next(iter(self.probes.values())) or []
            save_cached(expiries)
            return expiries
        return load_cached()


def install_daily_usage() -> None:
    """Keep per-day, per-model buckets for the cost chart (see daily_usage)."""
    sys.path.insert(0, str(HERE.parent))
    try:
        from agent_usage_collectors.daily_usage import install  # noqa: PLC0415
    except ImportError:
        return
    install()


def main() -> int:
    base = resolve_base()
    if base is None:
        print("Claude compatibility collector: Omarchy's Claude collector was not found", file=sys.stderr)
        return 1
    args = sys.argv[1:]
    try:
        code = compile(base.read_text(encoding="utf-8"), str(base), "exec")
    except (SyntaxError, ValueError, UnicodeDecodeError):
        code = None
    namespace: dict[str, Any] = {"__name__": "agent_usage_plus_claude_base", "__file__": str(base)}
    if code is not None:
        install_daily_usage()
        sys.argv[0] = str(base)
        exec(code, namespace)
    if code is None or not all(callable(namespace.get(name)) for name in ("main", "open_json", "emit")):
        # A custom scanner, or an upstream shape this doesn't know: run it
        # as it is, without free resets.
        os.execv(str(base), [str(base), *args])
    Tracker(namespace).install()
    return int(namespace["main"]() or 0)


if __name__ == "__main__":
    raise SystemExit(main())
